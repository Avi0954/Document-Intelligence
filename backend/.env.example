# Environment Configuration for Pragati Bharati Document Intelligence Service
PROJECT_NAME="Pragati Bharati - Document Intelligence Service"
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/docu_intelligence"

# Redis Queue Configuration
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# ====================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Pragati Bharati - AI Document Intelligence Service
# ====================================================================

ENVIRONMENT="production"
PROJECT_NAME="Pragati Bharati - Document Intelligence Service"
API_V1_STR="/api/v1"

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your_secure_64_character_random_hex_secret_here"

# Allowed CORS Origins (Comma-separated URLs or '*')
ALLOWED_ORIGINS="http://localhost:5173,https://your-frontend-domain.com"

# Managed PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Managed Redis / Queue URL (e.g. redis:// or rediss://)
REDIS_URL="redis://localhost:6379/0"

# Storage Settings
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# Gemini AI Credentials
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
